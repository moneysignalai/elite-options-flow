MASSIVE_API_KEY=your_key_here
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_TRADES_PATH_TEMPLATE=/options/trades?symbol={option_symbol}
MASSIVE_QUOTES_PATH_TEMPLATE=/options/quotes?symbol={option_symbol}
MASSIVE_SNAPSHOT_PATH_TEMPLATE=/options/snapshot?symbol={option_symbol}
MASSIVE_CONTRACT_SEARCH_PATH=/options/search?underlying={underlying}
SCAN_TICKERS=SPY,QQQ
CHAIN_DISCOVERY=reference
ENABLE_PREMARKET=false
ENABLE_AFTERHOURS=false
SCAN_INTERVAL_SECONDS=30
RTH_START=09:30
RTH_END=16:00
AGGRESSION_WINDOW_SECONDS=120
CLUSTER_WINDOW_SECONDS=90
MAX_LOOKBACK_MINUTES=5
GAMMA_DTE_MAX=3
STRUCTURAL_DTE_MIN=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=
ENABLE_POSTGRES=false
ALERT_SCORE_THRESHOLD=6.0
DEEP_DIVE_THRESHOLD=9.0
MEDIUM_THRESHOLD=7.0
COOLDOWN_MINUTES=30
